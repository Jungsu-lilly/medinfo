# 병원값 origin (EC2 안 Caddy, Docker host 네트워크)
#   사용자 ─HTTPS─▶ CloudFront ─HTTP :80 + 비밀 헤더(X-Origin-Verify)─▶ 여기 ─▶ web blue|green
#   - HTTPS·인증서는 CloudFront가 처리 → 여기는 http만 (auto_https off)
#   - 비밀 헤더가 없는 요청(서버 IP로 바로 온 봇 등)은 403, 기록도 안 남김 → 응답·로그 비용이 거의 0
#   - 지금 서비스 중인 색은 active.caddy (switch.sh가 바꾸고 caddy reload → 처리 중인 요청은 안 끊김)
# 배포 때마다 switch.sh가 이 파일을 /opt/medinfo/caddy/ 로 복사한다

{
	auto_https off
	# 요청 수·응답 시간·상태 코드 지표 → 관리 API(127.0.0.1:2019/metrics) → Prometheus
	metrics
}

:80 {
	# 접속 기록(JSON 한 줄) → stdout → CloudWatch /medinfo/prod. 쿠키·인증 헤더는 Caddy가 기본으로 가림
	# 사용자 IP는 CloudFront가 붙인 X-Forwarded-For 헤더에 있음
	log {
		output stdout
		format json
	}
	# 정적 파일(JS·CSS·폰트·아이콘)은 기록하지 않음: 페이지 하나에 수십 개라 로그 요금만 늘고 분석엔 안 씀
	@static path /_next/static/* /_next/image* /icons/* /icon* /apple-icon* /favicon.ico /sw.js /manifest.webmanifest
	log_skip @static

	@cloudfront header X-Origin-Verify {$ORIGIN_VERIFY}
	handle @cloudfront {
		# www.병원값.com → 병원값.com (주소 하나로 모아 검색 노출을 나누지 않음)
		@www host www.xn--639ao13amqh.com
		redir @www https://xn--639ao13amqh.com{uri} permanent

		import /etc/caddy/active.caddy
	}

	handle {
		log_skip
		respond 403
	}
}
