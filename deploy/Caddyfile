# 병원값 앞단 (EC2 안 Caddy, Docker host 네트워크)
#   - HTTPS 인증서: Let's Encrypt에서 자동 발급·갱신 (/opt/medinfo/caddy-data 에 보관 → 컨테이너를 다시 만들어도 유지)
#   - http(80) → https 자동
#   - 지금 서비스 중인 색은 active.caddy 한 줄 (switch.sh가 바꾸고 caddy reload → 처리 중인 요청은 안 끊김)
# 배포 때마다 switch.sh가 이 파일을 /opt/medinfo/caddy/ 로 복사한다

xn--639ao13amqh.com {
	# 접속 기록(JSON 한 줄) → stdout → CloudWatch /medinfo/prod. 쿠키·인증 헤더는 Caddy가 기본으로 가림
	log {
		output stdout
		format json
	}

	import /etc/caddy/active.caddy
}

# www.병원값.com → 병원값.com (주소 하나로 모아 검색 노출을 나누지 않음)
www.xn--639ao13amqh.com {
	redir https://xn--639ao13amqh.com{uri} permanent
}
